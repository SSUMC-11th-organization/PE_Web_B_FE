{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["src/**", "*.json", "*.ts", "*.js", "*.mjs", "!!next-env.d.ts"],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useAltText": "error"
      },
      "performance": {
        "noImgElement": "off"
      }
    },
    "includes": ["src/**"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
